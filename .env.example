# ==============================================================================
# Dynamic Portfolio Dashboard - Environment Configuration
# ==============================================================================

# Server-Side In-Memory Cache TTL (in seconds)
# Prevents rate-limiting Yahoo Finance / Google Finance requests
# Default: 15 seconds
MARKET_DATA_CACHE_TTL=15

# Upstream Market Data Request Timeout (in milliseconds)
MARKET_DATA_TIMEOUT_MS=6000

# Optional: Override Yahoo Finance API Base URL (default uses public query API)
YAHOO_FINANCE_API_URL=https://query1.finance.yahoo.com/v7/finance/quote

# Optional: Google Finance endpoint / custom fundamental proxy
GOOGLE_FINANCE_API_URL=
